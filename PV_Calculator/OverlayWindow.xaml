<Window x:Class="PV_Calculator.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PV_Calculator"
        mc:Ignorable="d"
        Title="OverlayWindow" 
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        AllowsTransparency="True" Topmost="True" Width="400" Height="200" WindowStartupLocation="CenterScreen">

    <Grid Background="White" Opacity="0.9">
        <StackPanel>
            <Label Margin=" 0,20,5,20" FontWeight="Bold" FontSize="16"  HorizontalAlignment="Center"> Please wait...</Label>
                <ProgressBar x:Name="overlayProgressBar"
                     IsIndeterminate="True"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Height="40"
                     Width="300"></ProgressBar>
        </StackPanel>
    </Grid>
</Window>
