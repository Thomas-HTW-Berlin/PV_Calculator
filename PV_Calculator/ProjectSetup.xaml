<Window x:Class="PV_Calculator.ProjectSetup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PV_Calculator"
        mc:Ignorable="d"
        Title="Project_Setup" Height="700
        " Width="1030">
    <Grid>
    <!-- Definiere ein Grid mit drei Spalten -->
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <!-- Erste Spalte -->
        <ColumnDefinition Width="Auto" />
        <!-- Separator -->
        <ColumnDefinition Width="*" />
        <!-- Zweite Spalte -->
    </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
        <Label FontWeight="Bold">Please define a new Project: </Label>
        <DockPanel Height="20">
            <Label  Width="300" Height="30" >Project Name :</Label>
            <TextBox Width="100"  Name="DoubleTextName" Text="{Binding Default_Name}"/>
        </DockPanel>
        <DockPanel Height="20">
            <Label  Width="300" Height="30" >Location GPS Noth (Berlin =52,532) :</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextGpsNorth" Text="{Binding Default_gps_north}"/>
        </DockPanel>
        <DockPanel Height="20">
            <Label Width="300" Height="30">Location GPS East (Berlin =13,392) :</Label>
            <TextBox Width="100" Margin="1
                     " Name="DoubleTextGpsEast" Text="{Binding Default_gps_east}"/>
        </DockPanel>
        <DockPanel Height="20">
            <Label  Width="300" Height="30">Number of PV panels :</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextNumber" Text="{Binding Default_panel_number}"/>
        </DockPanel>
        <DockPanel  Height="20">
            <Label  Width="300" Height="30">Power per PV panel (STC) [W]:</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextPower" Text="{Binding Default_panel_power}"/>
        </DockPanel>

        <DockPanel  Height="20">
            <Label  Width="300" Height="30"> Tilt Angle (0=horizontal) :   </Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextTilt" Text="{Binding Default_tilt}"/>
        </DockPanel>
        <DockPanel  Height="20">
            <Label Width="300" Height="30" >Orientation (0=south 180= north) :</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextSouth" Text="{Binding Default_south_angle}"/>
        </DockPanel>
        <DockPanel  Height="20">
            <Label Width="300" Height="30" >Average annual Temperature acc. en.climate-data.org:</Label>
                <TextBox Width="100" Margin="1" Name="DoubleTextAverageTemp" Text="{Binding Default_AverageTemp}"/>
        </DockPanel>
            <Label Width="300" Height="30" ></Label>


            <Separator />
            <Label Height="30" FontWeight="Bold"> Cooling of PV panels:</Label>
        <RadioButton Name="B1" GroupName="cooling" Height="18" Width="276" Checked="RadioButton_Checked">29 roof-parallel, well ventilated</RadioButton>
        <!--   <RadioButton IsChecked="True" GroupName="cooling" Height="18" Width="276" Checked="RadioButton_Checked">29 roof-parallel, well ventilated</RadioButton> -->
        <RadioButton Name="B2" GroupName="cooling" Height="18" Width="276" Checked="RadioButton_Checked"> 32 roof-integrated - back-ventilated </RadioButton>
        <RadioButton Name="B3" GroupName="cooling" Height="18" Width="276" Checked="RadioButton_Checked"> 43 roof-integrated - not back-ventilated</RadioButton>
        <RadioButton Name="B4" GroupName="cooling" Height="18" Width="276" Checked="RadioButton_Checked"> 28 elevated – roof-top</RadioButton>
        <RadioButton Name="B5" GroupName="cooling" Height="18" Width="276" Checked="RadioButton_Checked"> 22 elevated – ground-mounted</RadioButton>
        
        <Separator />

            <Label Height="30" FontWeight="Bold">Load Profile:</Label>

            <RadioButton Name="C1" GroupName="load" Height="18" Width="276" Checked="LoadButton_Checked">private home</RadioButton>
            <RadioButton Name="C2" GroupName="load" Height="18" Width="276" Checked="LoadButton_Checked">private home with PV-battery</RadioButton>
            <RadioButton Name="C3" GroupName="load" Height="18" Width="276" Checked="LoadButton_Checked">private home with PV-battery and heat pump</RadioButton>
            <RadioButton Name="C4" GroupName="load" Height="18" Width="276" Checked="LoadButton_Checked">office 8 a.m. to 5 p.m. with PV-battery</RadioButton>
            <RadioButton Name="C5" GroupName="load" Height="18" Width="276" Checked="LoadButton_Checked">Industry 1 shift with PV-battery</RadioButton>
            <RadioButton Name="C6" GroupName="load" Height="18" Width="276" Checked="LoadButton_Checked">Industry 2 shifts with PV-battery</RadioButton>


            <DockPanel  Height="20">
            <Label Width="300" Height="30" >Annual power consumption [MWh]:</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextConsumption" Text="{Binding Default_consumption}"> </TextBox>
        </DockPanel>
        <DockPanel Height="20">
            <Label Width="300" Height="30" >Costs for electricity [€/kWh]:</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextElCost" Text="{Binding Default_cost}"></TextBox>
        </DockPanel>
        <DockPanel Height="20">
            <Label Width="300" Height="30" >Grid feed in tariff  [€/kWh]:</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextFeedIn" Text="{Binding Default_feed_in}"></TextBox>
        </DockPanel>
        <DockPanel Height="20">
            <Label Width="300" Height="30" >Inflation rate [%]:</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextInflation" Text="{Binding Default_Inflation}"></TextBox>
        </DockPanel>

        <DockPanel  Height="20">
        <Label Width="300" Height="30" > Cost for PV systems [€/kWp]:</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextPVcost" Text="{Binding Default_pv_cost}"></TextBox>
        </DockPanel>
        <DockPanel Height="20">
            <Label Width="300" Height="30" > Cost for battery systems  [€/kWh]:</Label>
            <TextBox Width="100" Margin="1" Name="DoubleTextBatteryCost" Text="{Binding Default_battery_cost}"></TextBox>
        </DockPanel>
        <DockPanel Height="20">
                <Label Width="300" Height="30" >Battery capacity  [kWh]:</Label>
             <TextBox Width="100" Margin="1" Name="DoubleTextBatteryCapacity" Text="{Binding Default_battery_capacety}"></TextBox>
         </DockPanel>
         <DockPanel Height="20">
             <Label Width="300" Height="30" >Battery converter power [kW] (typ 0.2 * capacty):</Label>
             <TextBox Width="100" Margin="1" Name="DoubleTextBatteryConverterPower" Text="{Binding Default_battery_converter_Power}"></TextBox>
         </DockPanel>
        
       
      





          
           
    </StackPanel>
        <!-- Der Separator als Border -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="0,10" />

        <StackPanel Grid.Column="2">
            <Label Height="30"></Label>
            <Label Height="30" FontWeight="Bold"> Heatpump :</Label>
            <DockPanel Height="20">
                <Label Width="300" Height="30" >Annual power consumption for heating [MWH]:</Label>
                <TextBox Width="100" Margin="1" Name="DoubleTextHeatpumpConsumption" Text="{Binding Default_HeatpumpConsumption}"></TextBox>
            </DockPanel>
            <DockPanel Height="20">
                <Label Width="300" Height="30" >Annual energy for hot water [MWH]:</Label>
                <TextBox Width="100" Margin="1" Name="DoubleTextCost_HotWaterCurrent" Text="{Binding Default_HotWhater_Current}"></TextBox>
            </DockPanel>
            <DockPanel Height="20">
                <Label Width="300" Height="30" >Cost for heat pump current [€/kWH]:</Label>
                <TextBox Width="100" Margin="1" Name="DoubleTextCost_HeatpumpCurrent" Text="{Binding Default_HeatpumpcostCurrent}"></TextBox>
            </DockPanel>
            <DockPanel Height="20">
                <Label Width="300" Height="30" >Annual performance factor heat pump:</Label>
                <TextBox Width="100" Margin="1" Name="DoubleTextHeatpumpJAZ" Text="{Binding Default_HeatpumpJAZ}"></TextBox>
            </DockPanel>
            <Label Width="300" Height="30" ></Label>


            <Separator />
            <Label FontWeight="Bold">Extendet options (don't change if not sure):</Label>

            <DockPanel>
                <Label Width="300" Height="30" >Derating (dirt, aging and losses   typ.:0,85) :</Label>
                <TextBox Width="100" Margin="5" Name="DoubleTextDerating" Text="{Binding Default_derating_factor}"></TextBox>
            </DockPanel>
            <DockPanel>
                <Label Width="300" Height="30" >Temperature coeff.   typ.: -0,48 :</Label>
                <TextBox Width="100" Margin="5" Name="DoubleTextCoolingCoeff" Text="{Binding Default_delta_T}"></TextBox>
            </DockPanel>
            <DockPanel>
                <Label Width="300" Height="30" >Albedo (module reflection   typ.: 0,2):</Label>
                <TextBox Width="100" Margin="5" Name="DoubleTextAlbedo" Text="{Binding Default_albedo}"></TextBox>
            </DockPanel>
            <Label Height="30"></Label>

            <DockPanel>
                <Label Height ="50" Width="50"></Label>

                <Button x:Name= "Save" Content="Save / Apply" Click="SaveButton_Checked_1" Width="130" Margin="20 0 5 5 "/>
                <Button x:Name= "Exit" Content="Exit" Click="Exit_Click" Width="100" Margin="20 0 5 5 "/>
            </DockPanel>

        </StackPanel>

    </Grid>
</Window>
